{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
